# 로컬 개발: 비워두면 /api를 vite 프록시로 백엔드에 보냄
VITE_API_BASE_URL=
# 로컬 백엔드 주소 (프록시 대상)
VITE_API_PROXY_TARGET=http://localhost:8080
# 포트원 카드 등록 (값은 팀에서 받아 .env에 넣음)
VITE_PORTONE_STORE_ID=
VITE_PORTONE_BILLING_CHANNEL_KEY=
VITE_PORTONE_PAYMENT_CHANNEL_KEY=
# 소셜 로그인 (카카오는 REST API 키, 값은 팀에서 받아 .env에 넣음)
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_CLIENT_ID=
